#!/bin/sh
# route.mynet — OpenWrt 路由管理（薄封装，委托 L6 执行器）
#
# 历史上本脚本自己 parse conf/route.conf 并 `ip route add/del`，
# 与桌面/Linux 的 `mynet apply` 是两套写入者（冲突策略/删除语义还各写各的）。
# 归一后：**唯一写入者 = mynet apply**（spec/route-apply-unification.md），
# 本脚本只保留 init.d 兼容的 CLI 面，内部转调：
#
#   route.mynet start  → mynet apply --auto    # 从 bundle.network.routes 装
#   route.mynet stop   → mynet apply --clear   # 只清隧道口上的（只删自己装的）
#   route.mynet status → 列出隧道口路由（只读）
#
# 路由配置 SSOT 是 $MYNET_HOME/var/bundle.json 的 network.routes，
# **不是** conf/route.conf（那是 gnb 的地址宣告，不进内核）。

if [ -z "${MYNET_HOME:-}" ]; then
    echo "[route.mynet] FATAL: MYNET_HOME not set" >&2
    echo "[route.mynet]   export MYNET_HOME=/etc/mynet  或  --mynet-home /etc/mynet" >&2
    exit 1
fi
if [ ! -d "$MYNET_HOME" ]; then
    echo "[route.mynet] FATAL: MYNET_HOME not a directory: $MYNET_HOME" >&2
    exit 1
fi

log() { echo "[route.mynet] $*"; logger -t route.mynet "$*" 2>/dev/null; }
log_error() { echo "[route.mynet] ERROR: $*" >&2; logger -t route.mynet -p err "$*" 2>/dev/null; }

find_mynet() {
    for p in /usr/sbin/mynet /usr/bin/mynet "$MYNET_HOME/bin/mynet"; do
        [ -x "$p" ] && { echo "$p"; return 0; }
    done
    return 1
}

main() {
    command="${1:-}"
    shift 2>/dev/null || true

    interface=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --config|--interface)
                # --config 已无意义（bundle 为 SSOT）；--interface 仅 status 用
                if [ "$1" = "--interface" ]; then interface="$2"; fi
                shift 2
                ;;
            --mynet-home)
                MYNET_HOME="$2"; export MYNET_HOME
                shift 2
                ;;
            -h|--help)
                cat <<'EOF'
Usage: route.mynet <start|stop|status> [--interface NAME] [--mynet-home DIR]

  start   mynet apply --auto   （装 bundle.network.routes，含冲突过滤/所有权闸）
  stop    mynet apply --clear  （只清隧道口路由，不碰系统其他路由）
  status  列出隧道口上的 IPv4 路由（只读）

唯一写入者是 mynet apply；本脚本是 init.d 兼容封装。
EOF
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    mynet=$(find_mynet) || {
        log_error "mynet binary not found (expect /usr/sbin/mynet)"
        exit 1
    }

    case "$command" in
        start)
            log "delegate: $mynet apply --auto"
            MYNET_HOME="$MYNET_HOME" "$mynet" apply --auto
            exit $?
            ;;
        stop)
            log "delegate: $mynet apply --clear"
            MYNET_HOME="$MYNET_HOME" "$mynet" apply --clear
            exit $?
            ;;
        status)
            if [ -n "$interface" ]; then
                ip route show dev "$interface" 2>/dev/null
            else
                ip route show 2>/dev/null | grep -E 'dev (gnb|utun|tun|wg)' || true
            fi
            exit 0
            ;;
        *)
            log_error "Unknown command: ${command:-<empty>}"
            exit 1
            ;;
    esac
}

main "$@"
