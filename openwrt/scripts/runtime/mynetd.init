#!/bin/sh /etc/rc.common
# E-1/E-5：mynetd 由 procd 托管
USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/mynetd

start_service() {
	procd_open_instance mynetd
	procd_set_param command "$PROG" -listen 127.0.0.1:8096
	# OpenWrt 执行器 = lua -e（SSOT：桌面 exec mynet / OpenWrt lua -e）。
	# 不设则 mynetd 会 exec mynet 二进制——而 ipk 默认只带 mynetd。
	procd_set_param env MYNET_EXECUTOR=lua
	# respawn：3600s 窗口 / 5s 间隔 / 最多 5 次
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/mynet/conf/mynet.conf
	procd_close_instance
}

reload_service() {
	procd_send_signal mynetd '' 1   # SIGHUP
}

service_triggers() {
	procd_add_reload_trigger "mynet"
}
