# E-1 procd 接管（rc.common USE_PROCD=1）
# respawn / reload(SIGHUP) / hotplug 由 procd 负责
# 注意：gnb_es 孤儿必须先验证 PPID 清理（E-1 前置），再开 respawn
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance mynetd
    procd_set_param command /usr/sbin/mynetd
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/mynet/conf/mynet.conf
    procd_close_instance
}

reload_service() {
    procd_send_signal mynetd  # SIGHUP
}

stop_service() {
    :  # procd 停实例；gnb_es 孤儿清理见 E-3
}
