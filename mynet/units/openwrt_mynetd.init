#!/bin/sh /etc/rc.common
# mynetd — MyNet 纯通信层（procd 托管）
# 由 `mynet install` 写入 /etc/init.d/mynetd（OpenWrt 分支）。
#
# 职责边界（AGENTS.md §1.2）：mynetd 只做心跳/WS/命令分派；
# 系统能力在执行器（OpenWrt 走 lua -e）。
USE_PROCD=1
START=95
STOP=10
PROG=/usr/sbin/mynetd

start_service() {
	procd_open_instance mynetd
	procd_set_param command "$PROG" -listen 127.0.0.1:8096
	# OpenWrt 执行器 = lua -e（SSOT：桌面 exec mynet / OpenWrt lua -e）
	procd_set_param env MYNET_EXECUTOR=lua
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/mynet/conf/mynet.conf
	procd_close_instance
}

reload_service() {
	procd_send_signal mynetd '' 1
}

service_triggers() {
	procd_add_reload_trigger "mynet"
}
