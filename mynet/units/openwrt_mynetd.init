#!/bin/sh /etc/rc.common
# mynetd — MyNet 纯通信层（procd 托管）
# 由 `mynet install` 写入 /etc/init.d/mynetd（OpenWrt 分支）。
#
# 职责边界（AGENTS.md §1.2）：mynetd 只做心跳/WS/命令分派；
# 系统能力在执行器（OpenWrt 走 lua -e）。
USE_PROCD=1
START=95
STOP=10
PROG=/usr/sbin/mynetd

start_service() {
	procd_open_instance mynetd
	procd_set_param command "$PROG" -listen 127.0.0.1:8096
	# ⚠️ env 必须**一次设完**：`procd_set_param env` 是「设置」语义，再调一次会把
	# 前一次整份**替换**掉 —— 实测分两次调用时进程只剩最后一项（MYNET_EXECUTOR），
	# MYNET_HOME / MYNET_GATEWAYS 全丢，于是 mynetd 与经执行器委派的 `mynet config`
	# 都按 exe 目录推 home（得到 /usr/sbin/...），拉 bundle/心跳/身份查询全错位。
	#
	# MYNET_HOME 由 install 写进本行（不再有 mynetd.env —— 见 spec/paths.md §2.1）；
	# 网关列表归 $MYNET_HOME/conf/gateways.json，由 mynetd 自己读。
	procd_set_param env MYNET_EXECUTOR=lua MYNET_HOME=__MYNET_HOME__
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal mynetd '' 1
}

service_triggers() {
	procd_add_reload_trigger "mynet"
}
