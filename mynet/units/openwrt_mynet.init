#!/bin/sh /etc/rc.common
# mynet — 隧道服务（procd 托管，E-1）· 双驱动 gnb | wireguard
# 由 `mynet install` 写入 /etc/init.d/mynet（OpenWrt 分支）。
#
# 驱动分支自动判定（节点唯一存放位 conf/<form>/<nodeId>/ 里有 node.conf → gnb；
# 有 wg.conf → wireguard；旧 driver/{gnb/conf,wireguard} 只作回退）：
#   gnb       — 常驻进程，procd instance + respawn（E-1）
#   wireguard — 内核接口，无守护进程；start 装接口，stop 拆接口
#
# ⚠️ **不读旧扁平 conf/mynet.conf**：v2 起 agent 全 JSON（conf/ 是意图、var/ 是状态），
#    只有 gnb 驱动读它自己的节点目录 node.conf（D4-E：conf/<form>/<nodeId>/）。
#    init 需要的东西全部可从这三处推出（见 load_config）—— 旧扁平 conf 已退役。
#
# 路由唯一写入者仍是 `mynet apply`（route-apply-unification）。
# 安全红线：不按名字杀进程。
USE_PROCD=1
START=99
STOP=10

# 可选覆盖（过渡/调试）；**不存在也能跑**
CONFIG_FILE="${MYNET_CONFIG_FILE:-}"
MYNET_HOME="${MYNET_HOME:-/etc/mynet}"

log() { logger -t mynet "$*"; echo "[MyNet] $*"; }

# bundle 的接口名权威：$MYNET_HOME/var/bundle.json 的 node.interface。
# 与 agent 侧 domain.BundleEnvelope.TunDevice() 同一口径：权威缺失时暂认过渡别名
# gnb.options.ifname（旧后端只发那一份）；两者都有值且不等 → 不猜，报错。
bundle_tun_device() {
	local b="$MYNET_HOME/var/bundle.json"
	[ -f "$b" ] || return 0
	command -v jsonfilter >/dev/null 2>&1 || return 0

	local authority legacy
	authority=$(jsonfilter -i "$b" -e '@.node.interface' 2>/dev/null | tr -d '[:space:]"')
	legacy=$(jsonfilter -i "$b" -e '@.gnb.options.ifname' 2>/dev/null | tr -d '[:space:]"')
	if [ -n "$authority" ] && [ -n "$legacy" ] && [ "$authority" != "$legacy" ]; then
		log "ERROR: bundle 接口名冲突 node.interface=$authority vs gnb.options.ifname=$legacy"
		return 1
	fi
	[ -n "$authority" ] && { echo "$authority"; return 0; }
	[ -n "$legacy" ] && { echo "$legacy"; return 0; }

	return 0
}

# 节点唯一存放位（D4-E）：$MYNET_HOME/conf/<form>/<nodeId>（form+node 取 mode.json）。
node_confdir() {
	local modefile="$MYNET_HOME/conf/mode.json"
	[ -f "$modefile" ] || modefile="$MYNET_HOME/mode.json"
	[ -f "$modefile" ] || return 0
	local form node
	form=$(jsonfilter -i "$modefile" -e '@.mode' 2>/dev/null)
	node=$(jsonfilter -i "$modefile" -e '@.active.node_id' 2>/dev/null)
	[ "$form" = "online" ] || form="local"
	[ -n "$node" ] || return 0
	[ -d "$MYNET_HOME/conf/$form/$node" ] && echo "$MYNET_HOME/conf/$form/$node"
}

# 驱动原生 conf 目录（gnb）：节点唯一存放位（D4-E）；旧 driver/gnb/conf/<nodeId>/ 只作回退。
gnb_confdir() {
	local d
	d=$(node_confdir)
	[ -n "$d" ] && { echo "$d"; return 0; }
	ls -d "$MYNET_HOME"/driver/gnb/conf/*/ 2>/dev/null | head -1
}

# 从驱动自己的 node.conf 取接口名 —— gnb 读 .conf 是它的方言，不属"agent 读 conf"。
driver_ifname() {
	local d
	d=$(gnb_confdir)
	[ -n "$d" ] || return 0
	sed -n 's/^ifname[[:space:]][[:space:]]*//p' "$d/node.conf" 2>/dev/null | head -1
}

# 从驱动 conf 目录名取 nodeId（节点目录与旧 driver/gnb/conf/<nodeId> 同构）。
driver_nodeid() {
	local d
	d=$(gnb_confdir)
	[ -n "$d" ] || return 0
	basename "${d%/}"
}

load_config() {
	# 可选覆盖文件（过渡用）；没有也能跑
	if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ]; then
		. "$CONFIG_FILE"
	fi

	# VPN_TYPE：env > 覆盖文件 > 按驱动配置自动判定（无兜底默认名，只有"哪个驱动在"）
	VPN_TYPE="${MYNET_VPN_TYPE:-${VPN_TYPE:-}}"
	if [ -z "$VPN_TYPE" ]; then
		_nd=$(node_confdir)
		if [ -n "$_nd" ] && [ -f "$_nd/node.conf" ]; then
			VPN_TYPE=gnb
		elif [ -n "$_nd" ] && [ -f "$_nd/wg.conf" ]; then
			VPN_TYPE=wireguard
		elif [ -d "$MYNET_HOME/driver/gnb/conf" ]; then
			VPN_TYPE=gnb
		elif [ -d "$MYNET_HOME/driver/wireguard" ] || [ -f "$MYNET_HOME/var/wg.conf" ]; then
			VPN_TYPE=wireguard
		else
			log "ERROR: 找不到驱动配置（节点目录 conf/<form>/<nodeId>/ 或旧 driver/ 树）—— 先同步配置"
			return 1
		fi
	fi
	case "$VPN_TYPE" in
		gnb|wireguard|wg) ;;
		*) log "ERROR: unknown VPN_TYPE=$VPN_TYPE (want gnb|wireguard)"; return 1 ;;
	esac
	# wg 旧名归一
	[ "$VPN_TYPE" = "wg" ] && VPN_TYPE=wireguard

	# 接口名：显式配置 > bundle 权威 > 驱动自己的 node.conf。**不给通用兜底默认名**
	# （gnb_tun / wg0 都不行）：名字决定流量进哪条隧道，一台主机多个 zone 共存时
	# 兜底出来的恰好是别人的接口，而 ip link / wg-quick / uci 只要名字可用就执行成功、
	# 不报错 —— 症状变成「服务起来了、防火墙绑错口」，比启动失败难查得多。
	VPN_INTERFACE="${MYNET_VPN_INTERFACE:-${VPN_INTERFACE:-}}"
	[ -n "$VPN_INTERFACE" ] || VPN_INTERFACE=$(bundle_tun_device) || return 1
	[ -n "$VPN_INTERFACE" ] || [ "$VPN_TYPE" != "gnb" ] || VPN_INTERFACE=$(driver_ifname)
	[ -n "$VPN_INTERFACE" ] || {
		log "ERROR: VPN_INTERFACE 取不到（bundle 里没有、驱动 node.conf 也没有）—— 先同步配置"
		return 1
	}
	# OS 路由 SSOT = bundle.network.routes，由 `mynet apply --auto` 唯一写入；
	# 这里不再解析 route.conf（历史死变量，gnb 的 L5 宣告走 confdir/node.conf）
	return 0
}

get_node_id_from_conf() {
	if [ -n "$NODE_ID" ]; then echo "$NODE_ID"; return; fi
	if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ]; then
		sed -n 's/^NODE_ID=//p' "$CONFIG_FILE" 2>/dev/null | head -1
		return
	fi
	driver_nodeid
}

# procd 是异步拉起：gnb 起来到 tun 出现之间有几百 ms~几秒的窗口。
# 不等就直接跑 apply / firewall / post_start，症状是「服务起来了但
# 0 条 overlay 路由 + VPN device not found」，重启后节点必然不通。
wait_for_tun() {
	local tries="${1:-15}" i=0
	while [ "$i" -lt "$tries" ]; do
		if ip link show "$VPN_INTERFACE" >/dev/null 2>&1; then
			[ "$i" -gt 0 ] && log "tun $VPN_INTERFACE ready after ${i}s"
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	log "WARNING: tun $VPN_INTERFACE ${tries}s 内未出现 —— 路由与防火墙规则缺失，接口起来后需补跑 mynet apply --auto"
	return 1
}

run_plugin_hooks() {
	local hook_name="$1"
	local plugin_dir="$MYNET_HOME/scripts/plugin"
	[ -d "$plugin_dir" ] || return 0
	for plugin_path in "$plugin_dir"/*; do
		[ -d "$plugin_path" ] || continue
		local hook_script="$plugin_path/${hook_name}.sh"
		if [ -f "$hook_script" ] && [ -x "$hook_script" ]; then
			MYNET_HOME="$MYNET_HOME" "$hook_script" || \
				log "WARNING: hook $hook_script failed"
		fi
	done
}

# ── gnb：procd 常驻实例 ────────────────────────────────────────

# procd 当前托管的 gnb pid 列表（空格分隔）。取不到（无 ubus/jsonfilter/无实例）返回空。
procd_gnb_pids() {
	command -v ubus >/dev/null 2>&1 || return 0
	command -v jsonfilter >/dev/null 2>&1 || return 0
	ubus call service list '{"name":"mynet"}' 2>/dev/null \
		| jsonfilter -e '@.mynet.instances.gnb.pid' 2>/dev/null | tr '\n' ' '
}

# 收敛：同一节点（confdir）只允许一个 gnb 实例。
#
# 为什么需要：驱动侧的实例生命周期有两条入口 —— procd（本 init）与 `mynet`/mynetd
# 触发的 driver.Start/Reload（daemon 化、不受 procd 监管）。两者重叠时会留下
# 「procd 认的实例没有 tun、而孤儿进程占着 tun」的状态，之后 procd 只是不断重启那个
# 拿不到 tun 的实例（隧道时通时断）。系统 managedBy 的判据在驱动侧只覆盖 systemd
# （systemdManages()，见 driver/gnb.go:330），OpenWrt 缺这一条。
#
# 判据按 **confdir**：只清理指向本节点配置目录的 gnb，同机其它节点的 gnb 不受影响
# （多节点/多 zone 共存是设计支持的）。红线：pid + cmdline 精确停，绝不按名字杀。
converge_stale_gnb() {
	local confdir="$1" procd_pids p cmd
	procd_pids=$(procd_gnb_pids)
	[ -n "$procd_pids" ] || procd_pids=" "   # 成员判据要能匹配空集
	for p in $(pidof gnb 2>/dev/null); do
		case " $procd_pids " in *" $p "*) continue ;; esac
		cmd=$(tr '\0' ' ' < "/proc/${p}/cmdline" 2>/dev/null) || continue
		case "$cmd" in
			*"$confdir"*)
				log "converge: 停止同节点遗留 gnb pid=$p（procd 未托管，$confdir）"
				kill "$p" 2>/dev/null || true
				sleep 1
				kill -9 "$p" 2>/dev/null || true
				;;
		esac
	done
}

start_gnb_instance() {
	local nid confdir bin
	nid=$(get_node_id_from_conf)
	confdir="${MYNET_HOME}/driver/gnb/conf/${nid}"
	bin="${MYNET_HOME}/driver/gnb/bin/gnb"
	[ -x "$bin" ] || bin="$(command -v gnb)"
	if [ -z "$nid" ] || [ ! -d "$confdir" ] || [ -z "$bin" ]; then
		log "ERROR: gnb not ready (nid=$nid conf=$confdir bin=$bin)"
		return 1
	fi
	# 收敛：注册 procd 实例前，先停掉本节点上 procd 未托管的遗留 gnb。
	converge_stale_gnb "$confdir"
	# E-2：daemon off，交给 procd 前台
	if [ -f "$confdir/node.conf" ]; then
		sed -i 's/^daemon on$/daemon off/' "$confdir/node.conf" 2>/dev/null || true
	fi
	log "procd gnb: $bin -c $confdir"
	procd_open_instance gnb
	procd_set_param command "$bin" -c "$confdir"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$confdir/node.conf"
	procd_close_instance
}

stop_gnb_instance() {
	local nid confdir es_bin gnb_pids gnb_pid owned pid exe ppid
	nid=$(get_node_id_from_conf)
	confdir="${MYNET_HOME}/driver/gnb/conf/${nid}"
	es_bin="${MYNET_HOME}/driver/gnb/bin/gnb_es"

	# 归属判据（G-9）：gnb_es 必须 (a) exe 是本部署的 gnb_es，(b) **父进程是本实例 gnb**
	# —— 后者按「gnb 的 cmdline 指向本实例 confdir」认定。
	# ⚠️ 必须在停 gnb **之前**取父 pid：gnb 一死，gnb_es 变孤儿(PPID=1)，而 PPID=1
	#    只说明「没有父进程」，**不证明属于本节点** —— 据此清理会误杀别的实例的孤儿。
	owned=""
	if [ -n "$nid" ] && [ -d "$confdir" ]; then
		gnb_pids=$(pidof gnb 2>/dev/null) || true
		for gnb_pid in $gnb_pids; do
			if tr '\0' ' ' < "/proc/${gnb_pid}/cmdline" 2>/dev/null | grep -qF -- "$confdir"; then
				owned="$owned $gnb_pid"
			fi
		done
	fi

	for pid in $(pidof gnb_es 2>/dev/null); do
		exe=$(readlink "/proc/${pid}/exe" 2>/dev/null) || continue
		[ "$exe" = "$es_bin" ] || continue
		ppid=$(awk '{print $4}' "/proc/${pid}/stat" 2>/dev/null) || continue
		case " $owned " in
			*" $ppid "*) ;;
			*) log "skip gnb_es pid=$pid（父进程 $ppid 非本实例 gnb，归属不可证）"; continue ;;
		esac
		kill "$pid" 2>/dev/null || true
		sleep 1
		kill -9 "$pid" 2>/dev/null || true
		log "cleaned gnb_es pid=$pid (parent gnb=$ppid)"
	done

	# procd 精确停实例（不按名字杀进程）
	procd_kill mynet gnb 2>/dev/null || true
}

# ── wireguard：内核接口（无常驻进程）─────────────────────────
# conf 约定（与 WireGuardDriver.WriteIntent 对齐，D4-E）：
#   节点唯一存放位 conf/<form>/<nodeId>/wg.conf 为权威；
#   $MYNET_HOME/var/wg.conf 与 /etc/wireguard/<iface>.conf 为兼容回退。
wg_conf_path() {
	local nd
	nd=$(node_confdir)
	if [ -n "$nd" ] && [ -f "$nd/wg.conf" ]; then
		echo "$nd/wg.conf"
	elif [ -f "$MYNET_HOME/var/wg.conf" ]; then
		echo "$MYNET_HOME/var/wg.conf"
	elif [ -f "/etc/wireguard/${VPN_INTERFACE}.conf" ]; then
		echo "/etc/wireguard/${VPN_INTERFACE}.conf"
	else
		return 1
	fi
}

start_wg_interface() {
	local conf
	conf=$(wg_conf_path) || {
		log "ERROR: wireguard conf not found (want conf/<form>/<nodeId>/wg.conf or $MYNET_HOME/var/wg.conf)"
		return 1
	}
	# wg-quick 只吃 /etc/wireguard/<iface>.conf（按文件名推接口名）；
	# 其它路径喂它会建出名叫 "wg" 之类的错误接口 —— 一律走 ip+wg 路线。
	if command -v wg-quick >/dev/null 2>&1 && [ "$conf" = "/etc/wireguard/${VPN_INTERFACE}.conf" ]; then
		log "wg-quick up ($conf)"
		wg-quick up "$VPN_INTERFACE" || return 1
		return 0
	fi
	# 无 wg-quick 时用 ip + wg 最小集（OpenWrt 精简环境）
	log "ip+wg setup ($conf)"
	ip link add dev "$VPN_INTERFACE" type wireguard 2>/dev/null || true
	# ⚠️ `wg setconf` **只认 wg 自己的键**，而 conf 是 wg-quick 格式（含 Address/Table/DNS…）：
	# 直接喂它会 `Line unrecognized: Address=…` 直接失败（2026-10-11 在 .182 实测）。
	# 先剥成 wg 形态再喂；键表与 agent 的 StripWGQuickKeys / `wg-quick strip` 一致。
	local wgconf
	wgconf=$(mktemp)
	sed -E '/^(Address|MTU|Table|DNS|PreUp|PostUp|PreDown|PostDown|SaveConfig)[[:space:]]*=/d' "$conf" > "$wgconf"
	wg setconf "$VPN_INTERFACE" "$wgconf" || { rm -f "$wgconf"; return 1; }
	rm -f "$wgconf"
	# 地址在 conf 的 [Interface] Address= 里，wg-quick 会读；纯 wg 不会
	local addr
	addr=$(sed -n 's/^Address[[:space:]]*=[[:space:]]*//p' "$conf" | head -1 | cut -d, -f1)
	[ -n "$addr" ] && ip address add "$addr" dev "$VPN_INTERFACE" 2>/dev/null || true
	ip link set up dev "$VPN_INTERFACE" || return 1
	return 0
}

stop_wg_interface() {
	if command -v wg-quick >/dev/null 2>&1; then
		case "$(wg_conf_path 2>/dev/null)" in
			"/etc/wireguard/${VPN_INTERFACE}.conf")
				wg-quick down "$VPN_INTERFACE" 2>/dev/null || true
				;;
			*)
				wg-quick down "/etc/wireguard/${VPN_INTERFACE}.conf" 2>/dev/null || true
				;;
		esac
	fi
	ip link del dev "$VPN_INTERFACE" 2>/dev/null || true
}

# USE_PROCD=1 的坑：start_service 只是在「描述实例」，procd 要等它返回之后才
# 真正 spawn gnb —— 在原地等 tun 是等不到的。原样直接跑 apply/firewall 的症状
# 是「服务显示正常、0 条 overlay 路由、firewall: VPN device not found」，
# 而且只在重启后出现（装完手工补跑过一次 apply 就看不出来）。
post_start_setup() {
	wait_for_tun 20 || {
		log "ERROR: tun $VPN_INTERFACE 未就绪，已跳过路由与防火墙收尾"
		return 1
	}

	# 路由：唯一写入者 = mynet apply
	if [ -x /usr/sbin/mynet ] || command -v mynet >/dev/null 2>&1; then
		MYNET_HOME="$MYNET_HOME" mynet apply --auto || \
			log "WARNING: mynet apply --auto failed"
	fi
	if [ -f "$MYNET_HOME/scripts/firewall.mynet" ]; then
		MYNET_HOME="$MYNET_HOME" sh "$MYNET_HOME/scripts/firewall.mynet" \
			start --interface "$VPN_INTERFACE" || log "WARNING: firewall failed"
	fi

	run_plugin_hooks "post_start"
	log "MyNet started ($VPN_TYPE)"
	return 0
}

# ── start / stop ───────────────────────────────────────────────
start_service() {
	load_config || return 1
	log "Starting MyNet (procd) type=$VPN_TYPE..."
	run_plugin_hooks "pre_start"

	case "$VPN_TYPE" in
		gnb)       start_gnb_instance || return 1 ;;
		wireguard) start_wg_interface || return 1 ;;
	esac

	# wg 的接口是同步 set up 的，可以直接收尾；gnb 交给 procd 异步拉起，
	# 收尾必须等 tun 出现之后再跑（见 post_start_setup 注释）。
	if [ "$VPN_TYPE" = "gnb" ]; then
		( post_start_setup ) &
		log "gnb 实例已交给 procd，路由/防火墙/post_start 在 tun 就绪后后台补齐"
		return 0
	fi

	post_start_setup
}

stop_service() {
	log "Stopping MyNet (procd)..."
	load_config || true
	run_plugin_hooks "stop"

	case "${VPN_TYPE:-gnb}" in
		gnb)       stop_gnb_instance ;;
		wireguard) stop_wg_interface ;;
		*)
			# 配置缺失时两边都收，保证不留半套。但 wg 那只**只在接口名已知时拆**：
			# 兜底一个 wg0 去 `ip link del` 会连别人的口一起拆掉（按名字删，不问归属）。
			stop_gnb_instance
			[ -n "${VPN_INTERFACE:-}" ] && stop_wg_interface
			;;
	esac

	if [ -x /usr/sbin/mynet ]; then
		MYNET_HOME="$MYNET_HOME" /usr/sbin/mynet apply --clear 2>/dev/null || true
	fi
	log "MyNet stopped"
}
