# V3-3：mynet_gateway 常驻单元（生产主机 10.182.236.180）
#
# 为什么绑回环而不是 0.0.0.0：
#   `gw.mynet.club` 由**主机 nginx** 反代到 `127.0.0.1:8097`
#   （`mynet_api/deploy/nginx.conf:165,183`）。绑回环有两个直接好处：
#     1. 不把 8097 暴露到公网 —— gateway **自身不鉴权**（C-3：纯透传 + 连接状态表），
#        敞开等于把节点面入口送给任何人
#     2. 按 `cmd/mynet_gateway/main.go:113` 的 fail-fast 规则，**回环监听不需要
#        `-internal-token`**；只有非回环才强制要（空口令下 `/v1/notify` 完全不校验，
#        任何人都能往节点推事件）
#
# ── presence（V4-5 已接 Redis）─────────────────────────────────
# 配了 MYNET_GATEWAY_REDIS_ADDR 就用 Redis：跨实例同步 online/verified 状态，
# 并把事件帧广播给连在别的实例上的节点（节点连 A、后端打到 B，靠它才推得过去）。
#
# 不配（或配了但连不上）→ 退回**内存 presence**：单实例完全可用；
# 双实例下后端打到没连着该节点的那台会 404，日志里大量 "node not online"。
# 配置走 EnvironmentFile，见 deploy/gateway.env.example 的 presence 段。
#
# ⚠️ 当前 H4b 尚未裁定 gw1/gw2，单实例部署可以**不配**。但双实例时
#    「Redis 可达」是硬前提 —— 而连不上不会报错，只会静默降级到内存，
#    于是呈现出「进程活着、跨实例不工作」这种最难查的状态。
#    所以生产上一旦开 gw1/gw2，先确认本单元的 Redis 配置真生效
#    （启动日志里应有 `presence 已接 Redis`，若见 `退回内存` 就是没生效）。

[Unit]
Description=MyNet gateway (node-face WS + /v1/relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 配置（后端内网地址等）走环境文件，不进 unit —— 部署值随环境变，unit 保持通用。
# `-` 前缀：文件不存在也不报错（gateway 在 upstream 为空时仍能起，只是 relay 无处可转）
EnvironmentFile=-/etc/mynet/gateway.env
ExecStart=/opt/mynet/bin/mynet_gateway -listen 127.0.0.1:8097

# 收到 SIGTERM 后优雅关闭：main.go 给在途请求 15s（shutdownTimeout），
# 这里留 20s 余量再 SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=5

# gateway 是 WS 服务器：每个节点连接占若干 fd，而 systemd 的默认 LimitNOFILE
# 在不少发行版上是 1024 —— 几百个节点就能把 fd 用光，症状是「新节点连不上、
# 老连接还活着」，看起来像网络问题。这里显式抬高。
LimitNOFILE=65536

# 非 root。gateway 不需要任何特权：不写路由、不碰驱动、不读私钥。
# ⚠️ 用 www-data 而不是专用的 mynet 用户：生产/staging 主机上**没有 mynet 这个用户**
# （实测 `id mynet` 不存在），照原样写 User=mynet 的话 systemd 直接起不来。
# 用户 2026-09-25 裁定就用 www-data。代价是与 php-fpm 同用户、隔离性略弱 ——
# gateway 不读私钥不写盘，风险可接受；若日后要更强隔离，先 useradd mynet 再改回来。
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 它不写盘（连接表在内存），因此**不**给 ReadWritePaths

[Install]
WantedBy=multi-user.target
