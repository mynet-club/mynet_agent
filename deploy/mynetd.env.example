# mynetd 节点运行配置（示例）
#
# 部署到 /etc/mynet/mynetd.env，权限 **0600 root:root**。
# 由 systemd 单元 EnvironmentFile 加载（见 systemd/mynetd.service）。
#
# ⚠️ 0600 不是形式主义：mynetd 派生的 `mynet refresh-config` 会把
#    $MYNET_HOME/conf/mynet.conf 里的 **NODE_PRIV_HEX 注入**到
#    $MYNET_HOME/var/gnb/security/<nodeid>.private（back 不下发私钥，
#    见 BundleEnvelopePublisher 的 P0-4 收口）。这个 env 文件本身不含私钥，
#    但它指向的 MYNET_HOME 含 —— 别把它放开权限。

# ── 必填 ───────────────────────────────────────────────────────

# 安装/数据根目录。下面这些都在它底下：
#   conf/mynet.conf        节点身份（NODE_ID / NODE_PRIV_HEX / NODE_PUB_HEX / BACK_PUB_HEX）
#   var/bundle.json        mynetd 拉到的 BundleEnvelope
#   var/gnb/               refresh-config 渲染出的 gnb 原生配置目录
#   var/system.json        mynet detector 的产物（apply 需要它）
# ⚠️ 不配的话 mynetd 用「可执行文件上推一级」、mynet 用当前工作目录 ——
#    两套约定不一致（cmd/mynetd/nodeface.go:54 已注明是待收敛项），
#    systemd 下工作目录是 /，**必然找不到**。所以这里必须显式配。
MYNET_HOME=/opt/mynet

# gateway 的节点面 WS 地址，逗号分隔可配多个（会依次尝试）。
# ⚠️ **配了它就是节点模式**（有 WS + 节点身份 + presence + commands + 心跳 + 驱动生命周期），
#    节点模式需要 root，理由见 systemd/mynetd.service 顶部。
#    不配 = 纯本机模式（只有 localapi）；桌面/GUI 场景请用 `mynetd -console`（D-8/D-12）。
MYNET_GATEWAYS=wss://gw.mynet.club/v1/node/connect

# ── 可选（不配都有合理默认）────────────────────────────────────

# 执行器 mynet 的路径。默认从 mynetd 自身路径推同目录下的 mynet
# （cmd/mynetd/main.go:283-290）。两者不同目录时才需要配。
#MYNET_BIN=/opt/mynet/bin/mynet

# 节点 ID。通常**不需要配** —— 节点面身份从 $MYNET_HOME/conf/mynet.conf 的
# NODE_ID 读（cmd/mynetd/nodeface.go），那才是权威来源。
#MYNET_NODE_ID=

# 日志。默认 info + text + stderr；MYNET_LOG_FORMAT=json 切成结构化（V4-1/V4-4）。
# systemd 下 stderr 进 journald，一般不用配 LOG_DIR。
#MYNET_LOG_LEVEL=info
#MYNET_LOG_FORMAT=text
#MYNET_LOG_DIR=
