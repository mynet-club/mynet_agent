#!/bin/sh
# 文件落地前置：腾出「在跑的旧二进制」。
#
# macOS 不允许覆写正在执行的 Mach-O（ETXTBSY），Installer 覆写
# /opt/mynet/bin/mynetd 与 /usr/local/bin/gnb 前必须先停：
#   - mynetd：launchd 摘掉（postinstall 的 mynet install 会重新 bootstrap）
#   - gnb：mynetd 拉起的数据面进程，杀掉后由新 mynetd auto_restore 重建
# 隧道会中断几秒 —— 就地升级的固有代价，卸载数据（conf/var）不受影响。
set -u
launchctl bootout system/com.mynet.mynetd 2>/dev/null || true
pkill -x gnb 2>/dev/null || true
sleep 1
exit 0
