#!/bin/sh
# pre-push：重量守护（lint + test）——「不推坏东西」的关口
# DoD 要求「测试通过」，这里强制执行
echo "▸ pre-push: make check"
ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0
if [ -f Makefile.guard ]; then
  exec make -f Makefile.guard check
fi
if [ -f Makefile ] && grep -q '^check:' Makefile 2>/dev/null; then
  exec make check
fi
sh .githooks/guard.sh || exit 1
echo "✓ pre-push: guard 通过（无 check 目标，跳过 lint/test）"
